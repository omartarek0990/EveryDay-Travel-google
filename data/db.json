        "en": "Siwa Oasis & Great Sand Sea Retreat",
        "enManual": true
      },
      "destinationId": "dest-siwa",
      "tagline": {
        "ar": "تجربة صحراوية أصيلة بين بحيرات الملح والعيون الكبريتية",
        "en": "An authentic desert journey across salt lakes and warm springs",
        "enManual": true
      },
      "badge": {
        "ar": "موسم الشتاء",
        "en": "Winter season",
        "enManual": true
      },
      "features": [
