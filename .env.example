# Database (optional PostgreSQL URLs if migrating to Neon/Supabase; local file-backed store is used by default in preview)
DATABASE_URL=
DIRECT_URL=

# Cloudinary Image Storage (optional; falls back to StaticStorage in local/preview when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Translation Provider (google | gemini | none)
TRANSLATION_PROVIDER=google
GOOGLE_TRANSLATE_API_KEY=

# Gemini API Key (injected automatically by AI Studio at runtime)
GEMINI_API_KEY=

# Public Site URL
APP_URL=http://localhost:3000
VITE_SITE_URL=http://localhost:3000

# Optional Session Signing Secret (auto-generated in memory if omitted)
SESSION_SECRET=

# Optional Owner Account Recovery Code (enables /admin/reset recovery page when set)
OWNER_RECOVERY_CODE=
